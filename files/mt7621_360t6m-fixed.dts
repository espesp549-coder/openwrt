/dts-v1/;

#include "mt7621.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "360,360t6m", "mediatek,mt7621-soc";
	model = "360T6M";

	aliases {
		led-boot = &led_system;
		led-failsafe = &led_system;
		led-upgrade = &led_system;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			label = "red:power";
			gpios = <&gpio 13 GPIO_ACTIVE_HIGH>;
		};

		led_system: system {
			label = "green:system";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};
};

&nand {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "Bootloader";
			reg = <0x0 0x80000>;
		};

		partition@80000 {
			label = "Nvram";
			reg = <0x80000 0x40000>;
			read-only;
		};

		partition@c0000 {
			label = "Bdata";
			reg = <0xc0000 0x40000>;
			read-only;
		};

		factory: partition@100000 {
			label = "Factory";
			reg = <0x100000 0x80000>;
			read-only;
			compatible = "nvmem-cells";
			#address-cells = <1>;
			#size-cells = <1>;

			macaddr_factory_e000: macaddr@e000 {
				reg = <0xe000 0x6>;
			};

			macaddr_factory_e006: macaddr@e006 {
				reg = <0xe006 0x6>;
			};
		};

		partition@180000 {
			label = "crash";
			reg = <0x180000 0x40000>;
			read-only;
		};

		partition@1c0000 {
			label = "crash_log";
			reg = <0x1c0000 0x40000>;
			read-only;
		};

		partition@200000 {
			label = "kernel";
			reg = <0x200000 0x400000>;
		};

		partition@600000 {
			label = "ubi";
			reg = <0x600000 0x7980000>;
		};
	};
};

/* منفذ الـCPU المتصل بمحرك الإيثرنت (gmac0 موروث من mt7621.dtsi) */
&gmac0 {
	nvmem-cells = <&macaddr_factory_e000>;
	nvmem-cell-names = "mac-address";
};

/* تفعيل وتسمية منافذ سويتش DSA الفعلية على اللوحة */
&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan3";
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan1";
		};

		port@3 {
			status = "okay";
			label = "wan";
			nvmem-cells = <&macaddr_factory_e006>;
			nvmem-cell-names = "mac-address";
		};
	};
};

/* تفعيل جسر PCIe (معطل افتراضيًا بالملف المشترك) */
&pcie {
	status = "okay";
};

/* شريحة الوايفاي MT7915 على المنفذ 1 - طابق هذا مع الفحص الفعلي بالأسفل */
&pcie1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x0>;
	};
};
